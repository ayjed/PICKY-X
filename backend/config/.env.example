# ==============================================================================
# Picky X API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/config/ and fill in your actual credentials.
# NEVER commit your real .env file or production secrets to Git.

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pickyx_db
DB_USER=root
DB_PASS=

# API Security Secret (Used for HMAC / Token Signature Verification)
# Generate a secure 64-character random string in production
API_SECRET_KEY=replace_with_a_secure_random_key_in_production

# Initial Admin Account Setup (Used ONLY by backend/setup_database.php)
# If left blank, setup_database.php will generate a cryptographically random password.
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=

